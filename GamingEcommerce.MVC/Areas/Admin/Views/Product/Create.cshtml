@model CreateProductViewModel

<div class="content-wrapper">
    <div class="row">
        <div class="col-md-6 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Adding a product</h4>
                    <form class="forms-sample" method="post" asp-action="Create">
                        <div class="form-group">
                            <label for="name">Name</label>
                            <input asp-for="Name" class="form-control" id="name" placeholder="Product Name">
                        </div>
                        <div class="form-group">
                            <label for="desc">Description</label>
                            <input asp-for="Description" class="form-control" id="desc" placeholder="Description">
                        </div>
                        <div class="form-group">
                            <label for="category">Select Category</label>
                            <select asp-for="CategoryId" asp-items="@Model.CategoryList"></select>
                        </div>
                        <div class="form-group">
                            <label for="additionalinfo">Additional Info</label>
                            <input asp-for="AdditionalInformation" class="form-control" id="additionalinfo" placeholder="Additional Info">
                        </div>
                        <div class="form-group">
                            <label for="Price">Price</label>
                            <input asp-for="Price" class="form-control" id="Price" placeholder="Price">
                        </div>
                        <div class="form-group">
                            <label for="DiscountPrice">Discount Price</label>
                            <input asp-for="DiscountPrice" class="form-control" id="DiscountPrice" placeholder="Discount Price">
                        </div>
                        <button type="submit" class="btn btn-primary mr-2">Submit</button>
                        <button class="btn btn-light">Cancel</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>