@model List<ProductViewModel>

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Manage Products</h4>

                <a class="btn btn-primary" asp-action="Create" asp-controller="Product">Add a product</a>
                
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var product in Model??[])
                            {
                                <tr>

                                    <td>
                                        @try
                                        {
                                            <img src="~/images/products/@product.ProductColors[0].ProductColorImages[0].ImageName" />
                                        } catch
                                        {
                                            <p class="text text-danger">This product is not visible on the site. <br />
                                                Because it doesn't have any variant. <br />
                                                Add variants.</p>
                                        }

                                    </td>

                                    <td>@product.Name - <p>@product.Id</p></td>
                                    @if(product.DiscountPrice>0)
                                    {
                                        <td><span style="text-decoration: line-through">@product.Price</span> - @product.DiscountPrice</td>
                                    } else
                                    {
                                        <td>@product.Price</td>
                                    }
                                    
                                    <td>
                                         @if (product.IsDeleted)
                                        {
                                            <a class="btn btn-outline-info" href="@Url.Action("Restore", "Product", new { area = "Admin", id = product.Id })">Restore</a>
                                        } else
                                        {
                                            @if (@product.ProductColors.Count > 0)
                                            {
                                                <a class="btn btn-success" asp-action="Details" asp-controller="Product" asp-area="" asp-route-id=@product.Id target="_blank">See Details</a>
                                            }
                                            
                                            <a class="btn btn-warning" href="@Url.Action("Edit", "Product", new { area = "Admin", id = product.Id })">Edit</a>

                                            <a class="btn btn-danger" href="@Url.Action("Delete", "Product", new { area = "Admin", id = product.Id })">Delete</a>
                                        }
                                        
                                    </td>
                                </tr>
                                }                     
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>