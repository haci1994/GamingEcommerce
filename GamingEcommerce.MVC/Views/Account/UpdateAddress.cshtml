@model UpdateAddressViewModel

<div class="row justify-content-center">
    <div class="col-md-6 grid-margin stretch-card">
        <form class="wd-form-address" id="formnewAddress" asp-action="UpdateAddress" method="post">
            <div class="title">Add a new address</div>
            <div class="box-field grid-2-lg">
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="FirstName"
                           id="FirstName" name="FirstName">
                    <label class="tf-field-label fw-4 text_black-2" for="FirstName">
                        First
                        name
                    </label>
                </div>
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="LastName"
                           id="LastName" name="LastName">
                    <label class="tf-field-label fw-4 text_black-2" for="LastName">
                        Last
                        name
                    </label>
                </div>
            </div>
            <div class="box-field">
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="AddressLine"
                           id="AddressLine" name="AddressLine">
                    <label class="tf-field-label fw-4 text_black-2"
                           for="AddressLine">Address Line</label>
                </div>
            </div>
            <div class="box-field">
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="Country"
                           id="Country" name="Country">
                    <label class="tf-field-label fw-4 text_black-2"
                           for="address">Country</label>
                </div>
            </div>
            <div class="box-field">
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="City"
                           name="City">
                    <label class="tf-field-label fw-4 text_black-2" for="city">City</label>
                </div>
            </div>
            <div class="box-field">
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="Province"
                           name="Province">
                    <label class="tf-field-label fw-4 text_black-2" for="city">Province</label>
                </div>
            </div>
            <div class="box-field">
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="PostalZipCode"
                           id="PostalZipCode" name="PostalZipCode">
                    <label class="tf-field-label fw-4 text_black-2"
                           for="AddressZipNew">PostalZipCode</label>
                </div>
            </div>
            <div class="box-field">
                <div class="tf-field style-1">
                    <input class="tf-field-input tf-input" asp-for="PhoneNumber"
                           id="PhoneNumber" name="PhoneNumber">
                    <label class="tf-field-label fw-4 text_black-2" for="phone">PhoneNumber</label>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-center gap-20">
                <button type="submit" class="tf-btn btn-fill animate-hover-btn">
                    Update                    address
                </button>
                <span class="tf-btn btn-fill animate-hover-btn btn-hide-address">Cancel</span>
            </div>
        </form>
    </div>
</div>
